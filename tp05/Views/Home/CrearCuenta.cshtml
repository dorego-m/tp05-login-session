@{

    ViewData["Title"] = "Home Page";
     var error = ViewBag.Error as string;
}

<div class="text-center">
    <h1 class="display-4">crear cuenta</h1>

    <form asp-action="CrearCuenta" method="post">
    <input type="text" name="username" value="" placeholder="Username" required/>
    <input type="text" name="nombre" value="" placeholder="Nombre" required/>
    <input type="text" name="apellido" value="" placeholder="Apellido" required/>
    <input type="password" name="password" value="" placeholder="Crear contraseña" required/>
    <select name="TipoUsuario" placeholder="Tipo de usuario" required>
    <option value="Alumno">Alumno</option>
    <option value="Docente">Docente</option>
    <option value="Coordinador">Coordinador</option>
    <option value="Padre">Padre</option>
    </select>
    <button type="submit">crear cuenta</button>
    </form>

    @if (!string.IsNullOrEmpty(error))
    {
        <p style="color:red">@error</p>
    }

    <a asp-controller="Home" asp-action="LoginHtml">Ya tenes cuenta? Inicia sesion aqui</a>

</div>
